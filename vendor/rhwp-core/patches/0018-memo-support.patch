+    #[test]
+    fn memo_request_reads_json_escapes() {
+        let author = "a\"b\\c";
+        let text = "C:\\dir\\n x \"q\" é 😀\n\ttab \u{1}";
+        let json = serde_json::json!({ "author": author, "text": text }).to_string();
+        assert_eq!(
