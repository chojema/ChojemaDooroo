+    fn hwpx_memo_field() -> Field {
+        let mut field = memo_field(7, 3, &["body"]);
+        field.command = memo_command(65535, 3, 7, "author");
+        field.parameters.items = vec![
+            Parameter::Integer {
+                name: Some("Prop".into()),
+                value: 0,
+            },
+            Parameter::String {
+                name: Some("Command".into()),
+                value: field.command.clone(),
+                preserve_space: false,
+            },
+            Parameter::String {
+                name: Some("ID".into()),
+                value: "memo3".into(),
+                preserve_space: false,
+            },
+            Parameter::Integer {
+                name: Some("Number".into()),
+                value: 3,
+            },
+            Parameter::String {
+                name: Some("Author".into()),
+                value: "author".into(),
+                preserve_space: false,
+            },
+        ];
+        field.raw_parameters_xml = Some("<hp:parameters cnt=\"5\"/>".into());
+        field
+    }
