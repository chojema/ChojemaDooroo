+    /// The HWP5 format keeps every memo list at the end of the last section. A
+    /// memo of an earlier section is written there, read back from there, and
+    /// kept when either section alone is edited.
+    #[test]
+    fn memo_lists_live_at_the_end_of_the_last_section() {
+        let doc = two_section_document();
+        let bytes = crate::serializer::serialize_hwp(&doc).unwrap();
+        let parsed = crate::parser::parse_document(&bytes).unwrap();
+        assert_eq!(memo_bodies(&parsed), [(0, "first body".to_string())]);
+        let has_list = |section: &crate::model::document::Section| {
+            crate::parser::body_text::section_stream_has_memo_list(
+                section.raw_stream.as_deref().unwrap(),
+            )
+        };
+        assert!(!has_list(&parsed.sections[0]));
+        assert!(has_list(&parsed.sections[1]));
+        assert_eq!(parsed.sections[1].paragraphs.len(), 1);
+
+        // Unedited: both streams are reused as they are.
+        let resaved =
+            crate::parser::parse_document(&crate::serializer::serialize_hwp(&parsed).unwrap())
+                .unwrap();
+        for (again, before) in resaved.sections.iter().zip(&parsed.sections) {
+            assert_eq!(again.raw_stream, before.raw_stream);
+        }
+
+        // Only the last section changes.
+        let mut last_edited = parsed.clone();
+        last_edited.sections[1].paragraphs[0].insert_text_at(0, "x");
+        last_edited.sections[1].raw_stream = None;
+        let reopened =
+            crate::parser::parse_document(&crate::serializer::serialize_hwp(&last_edited).unwrap())
+                .unwrap();
+        assert_eq!(memo_bodies(&reopened), [(0, "first body".to_string())]);
+
+        // Only the first section changes: the reused last stream would carry a
+        // stale tail, so it is written again with the current one.
+        let mut first_edited = parsed.clone();
+        for ctrl in &mut first_edited.sections[0].paragraphs[0].controls {
+            if let Control::Field(field) = ctrl {
+                if is_memo_field(field) {
+                    field.memo_paragraphs[0] = Paragraph::new_empty_like(&field.memo_paragraphs[0]);
+                    field.memo_paragraphs[0].insert_text_at(0, "new body");
+                    field.memo_paragraphs[0].has_para_text = true;
+                }
+            }
+        }
+        first_edited.sections[0].raw_stream = None;
+        let reopened = crate::parser::parse_document(
+            &crate::serializer::serialize_hwp(&first_edited).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(memo_bodies(&reopened), [(0, "new body".to_string())]);
+        assert!(!has_list(&reopened.sections[0]));
+    }
