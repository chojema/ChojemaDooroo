+    /// Hancom writes a 10-byte PARA_HEADER tail (instance id, no change-tracking
+    /// word) for memo bodies in older files. Writing the section from the model
+    /// keeps it as it is; only a body without a tail gets the zero one.
+    #[test]
+    fn memo_body_header_tails_survive_a_rebuilt_section() {
+        let mut core = core_with_text("anchor text");
+        core.insert_memo_at(0, 0, 0, 6, "tester", "one\ntwo")
+            .unwrap();
+        let hancom_tail = vec![0, 0, 0, 0, 0, 0, 0x4f, 0x82, 0x09, 0xaa];
+        for ctrl in &mut core.document.sections[0].paragraphs[0].controls {
+            if let Control::Field(field) = ctrl {
+                if is_memo_field(field) {
+                    field.memo_paragraphs[0].raw_header_extra = hancom_tail.clone();
+                }
+            }
+        }
+        let bytes = crate::serializer::body_text::serialize_section(&core.document.sections[0]);
+        let parsed = crate::parser::body_text::parse_body_text_section(&bytes).unwrap();
+        let tails: Vec<(usize, Vec<u8>)> = parsed.paragraphs[0]
+            .controls
+            .iter()
+            .filter_map(|ctrl| match ctrl {
+                Control::Field(field) if is_memo_field(field) => Some(field),
+                _ => None,
+            })
+            .flat_map(|field| field.memo_paragraphs.iter())
+            // the first six bytes are counts the writer recomputes
+            .map(|para| {
+                (
+                    para.raw_header_extra.len(),
+                    para.raw_header_extra[6..].to_vec(),
+                )
+            })
+            .collect();
+        assert_eq!(
+            tails,
+            [(10, hancom_tail[6..].to_vec()), (12, vec![0; 6])],
+            "the Hancom tail keeps its length and instance id"
+        );
+
+        // Through a whole HWP save (this blank document is a 5.0.3.2+ file, so
+        // the writer adds the change-tracking word): the instance id stays.
+        let reopened =
+            DocumentCore::from_bytes(&core.export_hwp_with_adapter_snapshot().unwrap()).unwrap();
+        let tails = memo_body_tails(&reopened);
+        assert_eq!(tails.len(), 2);
+        assert_eq!(&tails[0][6..10], &hancom_tail[6..10]);
+        assert!(tails[1][6..].iter().all(|byte| *byte == 0));
+    }
