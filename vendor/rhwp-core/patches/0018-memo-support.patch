+    /// A Hancom-shaped memo tail: the lists follow the real last paragraph,
+    /// which keeps the last-paragraph bit. No extra paragraph appears.
+    #[test]
+    fn hwp_save_adds_no_paragraph_for_the_memo_tail() {
+        let mut core = core_with_text("anchor text");
+        core.insert_memo_at(0, 0, 0, 6, "tester", "body").unwrap();
+        let mut bytes = core.export_hwp_with_adapter_snapshot().unwrap();
+        for _ in 0..3 {
+            let mut reopened = DocumentCore::from_bytes(&bytes).unwrap();
+            assert_eq!(reopened.document.sections[0].paragraphs.len(), 1);
+            assert_eq!(memo_texts(&reopened), ["body"]);
+            // an edit makes the next save write the section from the model
+            reopened.insert_text_native(0, 0, 11, "!").unwrap();
+            reopened.delete_text_native(0, 0, 11, 1).unwrap();
+            bytes = reopened.export_hwp_with_adapter_snapshot().unwrap();
+        }
+        let section = DocumentCore::from_bytes(&bytes).unwrap().document.sections[0]
+            .raw_stream
+            .clone()
+            .unwrap();
+        let records = crate::parser::record::Record::read_all(&section).unwrap();
+        let memo_list = records
+            .iter()
+            .position(|record| record.tag_id == tags::HWPTAG_MEMO_LIST)
+            .unwrap();
+        let last_para = records
+            .iter()
+            .rposition(|record| record.tag_id == tags::HWPTAG_PARA_HEADER && record.level == 0)
+            .unwrap();
+        assert!(last_para < memo_list);
+        let n_chars = u32::from_le_bytes(records[last_para].data[0..4].try_into().unwrap());
+        assert_ne!(
+            n_chars & 0x8000_0000,
+            0,
+            "the real last paragraph keeps the last bit"
+        );
+        assert!(
+            records[last_para + 1].tag_id == tags::HWPTAG_PARA_TEXT,
+            "and it is the anchor paragraph, not an empty one"
+        );
+    }
