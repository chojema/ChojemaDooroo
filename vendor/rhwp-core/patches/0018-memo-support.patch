+    /// A pasted memo from HWPX gets its new number in the parameters the HWPX
+    /// writer uses, not only in the command.
+    #[test]
+    fn renumbering_updates_hwpx_parameters() {
+        let mut para = para_with_text("anchor");
+        insert_memo_field_in_para(&mut para, 0, 2, hwpx_memo_field()).unwrap();
+        let mut paragraphs = vec![para];
+        renumber_memos(&mut paragraphs, 4);
+        let Some(Control::Field(field)) = paragraphs[0].controls.first() else {
+            panic!("memo field");
+        };
+        assert_eq!(field.memo_index, 4);
+        assert!(field.command.starts_with("MEMO/65535/4/7/"));
+        assert!(field.raw_parameters_xml.is_none());
+        let value = |key: &str| {
+            field.parameters.items.iter().find_map(|item| match item {
+                Parameter::Integer {
+                    name: Some(name),
+                    value,
+                } if name == key => Some(value.to_string()),
+                Parameter::String {
+                    name: Some(name),
+                    value,
+                    ..
+                } if name == key => Some(value.clone()),
+                _ => None,
+            })
+        };
+        assert_eq!(value("Number").as_deref(), Some("4"));
+        assert_eq!(value("ID").as_deref(), Some("memo4"));
+        assert_eq!(value("Command").as_deref(), Some(field.command.as_str()));
+        assert_eq!(value("Author").as_deref(), Some("author"));
+    }
