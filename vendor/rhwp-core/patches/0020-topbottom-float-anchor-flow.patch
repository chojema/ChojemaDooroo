+    #[test]
+    fn paper_topbottom_float_moves_its_anchor_flow_below_the_box() {
+        use super::topbottom_float_anchor_flow_bottom;
+        use crate::model::image::Picture;
+        use crate::model::shape::{CommonObjAttr, HorzRelTo, TextWrap, VertRelTo};
+        use crate::renderer::page_layout::LayoutRect;
+        use crate::renderer::{hwpunit_to_px, DEFAULT_DPI};
+
+        // 본문 (100, 100) 폭 600·높이 900 px, 종이 기준 상자 위끝 120 px·높이 150 px.
+        let body = LayoutRect {
+            x: 100.0,
+            y: 100.0,
+            width: 600.0,
+            height: 900.0,
+        };
+        let px_to_hu = |px: f64| (px * 7200.0 / DEFAULT_DPI).round() as u32;
+        let anchor = |wrap, vert, treat_as_char, top_px: f64| Paragraph {
+            controls: vec![Control::Picture(Box::new(Picture {
+                common: CommonObjAttr {
+                    treat_as_char,
+                    text_wrap: wrap,
+                    vert_rel_to: vert,
+                    horz_rel_to: HorzRelTo::Paper,
+                    vertical_offset: px_to_hu(top_px),
+                    horizontal_offset: px_to_hu(110.0),
+                    width: px_to_hu(500.0),
+                    height: px_to_hu(150.0),
+                    ..Default::default()
+                },
+                ..Default::default()
+            }))],
+            ..Default::default()
+        };
+        let bottom = 120.0 + hwpunit_to_px(px_to_hu(150.0) as i32, DEFAULT_DPI);
+        let jump = |para: &Paragraph, text_h: f64, flow_y: f64| {
+            topbottom_float_anchor_flow_bottom(para, text_h, flow_y, &body, &body, DEFAULT_DPI)
+        };
+
+        // 앵커 줄(본문 위 30 px)이 상자 안에서 시작한다 — 상자 아래끝으로 내린다.
+        let para = anchor(TextWrap::TopAndBottom, VertRelTo::Paper, false, 120.0);
+        let moved = jump(&para, 20.0, 30.0).expect("anchor moves below the box");
+        assert!((moved - (bottom - body.y)).abs() < 0.01, "moved to {moved}");
+        // 이미 상자 아래면 그대로다.
+        assert_eq!(jump(&para, 20.0, bottom - body.y + 1.0), None);
+        // 앵커 글이 상자 위에 들어가면 내리지 않는다(그리는 쪽과 같다).
+        let low = anchor(TextWrap::TopAndBottom, VertRelTo::Paper, false, 300.0);
+        assert_eq!(jump(&low, 20.0, 30.0), None);
+        // 단 위 1/3 아래에서 시작하는 개체, 문단 기준, 글자처럼 취급, 어울림은 대상이 아니다.
+        let at = |wrap, vert, treat_as_char, top_px| {
+            jump(&anchor(wrap, vert, treat_as_char, top_px), 400.0, 30.0)
+        };
+        assert_eq!(
+            at(TextWrap::TopAndBottom, VertRelTo::Paper, false, 450.0),
+            None
+        );
+        assert_eq!(
+            at(TextWrap::TopAndBottom, VertRelTo::Para, false, 0.0),
+            None
+        );
+        assert_eq!(
+            at(TextWrap::TopAndBottom, VertRelTo::Paper, true, 120.0),
+            None
+        );
+        assert_eq!(at(TextWrap::Square, VertRelTo::Paper, false, 120.0), None);
+
+        // 저장 첫 줄이 상자 안이면 그 문단이 낡은 사다리의 앵커다. 상자 아래 저장 줄은 아니다.
+        use super::first_stale_topbottom_float_anchor;
+        use crate::model::paragraph::LineSeg;
+        let stored_at = |mut para: Paragraph, top_px: f64| {
+            para.line_segs = vec![LineSeg {
+                vertical_pos: px_to_hu(top_px) as i32,
+                line_height: 1000,
+                line_spacing: 600,
+                ..Default::default()
+            }];
+            para
+        };
+        let plain = stored_at(Paragraph::default(), 0.0);
+        let inside = stored_at(para.clone(), 30.0);
+        let below = stored_at(para.clone(), bottom - body.y + 1.0);
+        let stale = |paras: &[Paragraph]| {
+            first_stale_topbottom_float_anchor(paras, &body, &body, DEFAULT_DPI)
+        };
+        assert_eq!(stale(&[plain.clone(), inside]), Some(1));
+        assert_eq!(stale(&[plain, below]), None);
+    }
